{
  "name": "gizmoplex-downloader",
  "version": "0.9.0",
  "description": "Archive videos, subtitles, and ZIP assets from your authorized Gizmoplex account.",
  "author": "Christopher D. Goldman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/au79/gizmoplex-downloader.git"
  },
  "bugs": {
    "url": "https://github.com/au79/gizmoplex-downloader/issues"
  },
  "homepage": "https://github.com/au79/gizmoplex-downloader#readme",
  "engines": {
    "node": ">=20.12.0"
  },
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "build:standalone": "node scripts/build-sea.mjs",
    "docker:build": "docker build -t gizmoplex-downloader .",
    "docker:run": "docker run --rm -it --env-file .env --volume \"$PWD/gizmoplex-archive:/archive\" gizmoplex-downloader --out /archive --interactive",
    "dry-run": "tsx src/app.ts --dry-run",
    "show-in-progress-plan": "tsx src/app.ts --show-in-progress-plan",
    "start": "tsx src/app.ts -i",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "progress": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/progress": "^2.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
